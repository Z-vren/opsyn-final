        },
        "propertySettings": {
          "day_of_the_week": {
            "type": "MANUAL"
          },
          "hour_of_the_day": {
            "type": "MANUAL"
          },
          "timezone": {
            "type": "MANUAL"
          }
        },
        "sampleData": {}
      },
      "nextAction": {
