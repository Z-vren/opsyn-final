{
  "name": "Weekly HTTP Request",
  "description": "Simple workflow that runs every week and sends an HTTP request",
  "tags": [],
  "pieces": [
    "@activepieces/piece-schedule",
    "@activepieces/piece-http"
  ],
  "template": {
    "displayName": "Weekly HTTP Request",
    "trigger": {
      "name": "trigger",
      "type": "PIECE_TRIGGER",
      "valid": true,
      "displayName": "Every Week",
      "settings": {
        "pieceName": "@activepieces/piece-schedule",
        "pieceVersion": "~0.1.13",
        "triggerName": "every_week",
        "input": {
