        "displayName": "Send HTTP Request",
        "settings": {
          "pieceName": "@activepieces/piece-http",
          "pieceVersion": "~0.9.5",
          "actionName": "send_request",
          "input": {
            "url": "https://api.example.com/webhook",
            "method": "GET",
            "headers": {},
            "queryParams": {},
            "body": {}
          },
          "propertySettings": {
            "url": {
              "type": "MANUAL"
            },
            "method": {
              "type": "MANUAL"
            }
          },
          "errorHandlingOptions": {
            "retryOnFailure": {
              "value": false
            },
            "continueOnFailure": {
              "value": false
            }
          }
        }
      }
    },
    "valid": true,
    "schemaVersion": "10"
  },
  "schemaVersion": null
