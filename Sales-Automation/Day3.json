                    "code": "export const code = async (inputs) => {\n  const inputDate = inputs[\"previous-email-sent-time\"]; // Fixed: removed the 's'\n  \n  if (!inputDate) {\n    return {\n      time_passed_hours: 0,\n      can_send_followup: false\n    };\n  }\n  \n  const lastSent = new Date(inputDate);\n  const now = new Date();\n  \n  if (isNaN(lastSent.getTime())) {\n    return {\n      time_passed_hours: 0,\n      can_send_followup: false\n    };\n  }\n  \n  const diffMs = now.getTime() - lastSent.getTime();\n  const diffHours = diffMs / (1000 * 60 * 60);\n  \n  return {\n    time_passed_hours: Math.round(diffHours * 100) / 100,\n    can_send_followup: diffHours >= 72\n  };\n};",
                    "packageJson": "{}"
